# ─────────────────────────────────────────────
# Deployment configuration for deploy.sh
# ─────────────────────────────────────────────

# Required
BUCKET_NAME=
DISTRIBUTION_ID=        # replace with your real CloudFront distribution ID
S3_PREFIX=

# Optional (defaults shown in comments)
BUILD_DIR=                       # "build" for Create React App, "dist" for Vite
AWS_PROFILE=          # the named CLI profile you configured
BUILD_CMD=              # command that produces the build output

# ─────────────────────────────────────────────
# VITE ENV Variable
# ─────────────────────────────────────────────

# URL of the public portfolio site (portfolio-client). Used for the
# "Back to site" / "Exit" links out of the domain app. Same in every
# mode, so it belongs in .env rather than a per-mode file.
VITE_PUBLIC_SITE_URL=

# NOTE: VITE_API_BASE_URL is intentionally NOT set in this file. It
# differs between local dev and production builds, so set it in
# .env.development (local) and .env.production (build/deploy) instead -
# see those files. Anything set in .env gets exported into the shell by
# deploy.sh before it runs $BUILD_CMD, and a real process.env value
# always wins over a mode file's value in Vite, so a value here would
# silently override .env.production during deploys.
