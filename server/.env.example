# Required
SERVER_IP=

# Optional (defaults shown)
SSH_USER=ubuntu
SSH_KEY=
REMOTE_DIR=/home/ubuntu
SERVICE_NAME=domain
BINARY_NAME=domain
GOARCH_TARGET=amd64

# Optional. Name of the production database to back up (via pg_dump over
# SSH) before every deploy. Dumps land in server/backups/ (gitignored).
DB_NAME=portfolio

# ─────────────────────────────────────────────
# Runtime config (cmd/main.go)
# ─────────────────────────────────────────────

# Required. Fixed password gating the domain area — checked against the
# POST /api/auth/login request body.
DOMAIN_PASSWORD=

# Required. Signing secret for the JWTs issued on login. Generate one with,
# e.g., `openssl rand -base64 32`.
JWT_SECRET=

# Required. Postgres connection string. When running via
# `docker compose up` at the repo root, this matches the `postgres` service
# defined there. From inside the compose network (i.e. the `server`
# container) the host is "postgres"; connecting from your own machine
# (e.g. psql) instead, use "localhost:5433" — the compose file maps the
# container's 5432 to host 5433 to avoid clashing with any other local
# Postgres on 5432.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5433/portfolio?sslmode=disable

# Optional. CORS origin allowed to call the API. Defaults to "*".
ALLOWED_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────
# Spotify integration (internal/spotify)
# ─────────────────────────────────────────────
# The domain area has exactly one Spotify connection (no per-user auth to
# key multiple by — see DOMAIN_PASSWORD above), authorized once via the
# "Connect Spotify" widget and refreshed server-side after that.

# Required. From your app at developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Required. Must exactly match a Redirect URI registered on that Spotify
# app. Local dev example: http://127.0.0.1:8080/api/spotify/callback
SPOTIFY_REDIRECT_URI=

# Required. Where the browser lands after the OAuth round-trip finishes,
# success or failure (?spotify=connected / ?spotify=error is appended) — a
# route already behind RequireAuth in domain-client, e.g.
# http://localhost:5173/settings
SPOTIFY_FRONTEND_REDIRECT_URL=

# Required. Base64-encoded 32-byte key used to encrypt the stored Spotify
# refresh token at rest (kept separate from JWT_SECRET, which only signs —
# it never protects data sitting in the database). Generate with:
# openssl rand -base64 32
SPOTIFY_TOKEN_KEY=
