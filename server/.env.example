# Required
SERVER_IP=

# Optional (defaults shown)
SSH_USER=ubuntu
SSH_KEY=
REMOTE_DIR=/home/ubuntu
SERVICE_NAME=domain
BINARY_NAME=domain
GOARCH_TARGET=amd64

# ─────────────────────────────────────────────
# Runtime config (cmd/main.go)
# ─────────────────────────────────────────────

# Required. Fixed password gating the domain area — checked against the
# POST /api/auth/login request body.
DOMAIN_PASSWORD=

# Required. Signing secret for the JWTs issued on login. Generate one with,
# e.g., `openssl rand -base64 32`.
JWT_SECRET=

# Required. Postgres connection string. When running via
# `docker compose up` at the repo root, this matches the `postgres` service
# defined there. From inside the compose network (i.e. the `server`
# container) the host is "postgres"; connecting from your own machine
# (e.g. psql) instead, use "localhost:5433" — the compose file maps the
# container's 5432 to host 5433 to avoid clashing with any other local
# Postgres on 5432.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5433/portfolio?sslmode=disable

# Optional. CORS origin allowed to call the API. Defaults to "*".
ALLOWED_ORIGIN=http://localhost:5173
