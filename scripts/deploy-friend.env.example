# Config for scripts/deploy-friend.sh. Copy this file to
# scripts/deploy-friend.env (gitignored) and fill in real values.
# One-time server-side setup (Postgres role/DB, systemd unit, Caddy block,
# /etc/domain-anjali/domain.env) is documented in scripts/friend-server-setup.md
# and is NOT done by this script.

# ─────────────────────────────────────────────
# Server connection
# ─────────────────────────────────────────────
SERVER_IP=
SSH_USER=root
SSH_KEY=

# ─────────────────────────────────────────────
# Backend (its own systemd service + port, shares the box with the main
# `domain` service but nothing else)
# ─────────────────────────────────────────────
FRIEND_SERVICE_NAME=domain-anjali
FRIEND_BINARY_NAME=domain-anjali
FRIEND_REMOTE_DIR=/root
FRIEND_DB_NAME=portfolio_anjali

# ─────────────────────────────────────────────
# Frontend (built locally, rsynced to a directory Caddy serves statically
# on the shared box — no S3/CloudFront involved)
# ─────────────────────────────────────────────
FRIEND_DOMAIN=                                  # e.g. herapp.dev — must match the Caddyfile site block
FRIEND_STATIC_REMOTE_DIR=/var/www/REPLACE_ME    # e.g. /var/www/herapp.dev
FRIEND_PUBLIC_SITE_URL=                         # target for the "Leave Domain" exit link; defaults to https://$FRIEND_DOMAIN if unset
